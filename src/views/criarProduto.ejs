<!-- Usei IA para deixar mais apresentável, mas a estrutura anterior era simples, era só um formulário -->

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cadastrar Produto</title>

    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #1e1e2f, #302b63);
        padding: 30px;
      }

      .container {
        width: 100%;
        max-width: 550px;
        background-color: #ffffff;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
      }

      h1 {
        text-align: center;
        color: #292943;
        margin-bottom: 8px;
      }

      .descricao {
        text-align: center;
        color: #777;
        margin-bottom: 30px;
        font-size: 14px;
      }

      .campo {
        margin-bottom: 20px;
      }

      label {
        display: block;
        margin-bottom: 7px;
        font-weight: bold;
        color: #333;
      }

      input {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 15px;
        outline: none;
        transition: 0.2s;
      }

      input:focus {
        border-color: #5b5bd6;
        box-shadow: 0 0 0 3px rgba(91, 91, 214, 0.15);
      }

      input[type="file"] {
        padding: 10px;
        background-color: #f7f7f7;
        cursor: pointer;
      }

      button {
        width: 100%;
        padding: 13px;
        margin-top: 10px;
        border: none;
        border-radius: 8px;
        background-color: #5b5bd6;
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s;
      }

      button:hover {
        background-color: #4747b8;
        transform: translateY(-1px);
      }

      button:active {
        transform: translateY(0);
      }
    </style>
  </head>

  <body>
    <main class="container">
      <h1>🎮 Cadastrar Produto</h1>

      <p class="descricao">
        Preencha as informações abaixo para adicionar um novo produto.
      </p>

      <form action="/api/produtos" method="post" enctype="multipart/form-data">
        <div class="campo">
          <label for="nome">Nome:</label>
          <input
            type="text"
            id="nome"
            name="nome"
            placeholder="Ex: Pokémon Diamond"
            required
          />
        </div>

        <div class="campo">
          <label for="preco">Preço:</label>
          <input
            type="number"
            id="preco"
            name="preco"
            min="0"
            step="0.01"
            placeholder="Ex: 199.90"
            required
          />
        </div>

        <div class="campo">
          <label for="lancamento">Ano de lançamento:</label>
          <input
            type="number"
            id="lancamento"
            name="lancamento"
            min="1950"
            placeholder="Ex: 2006"
            required
          />
        </div>

        <div class="campo">
          <label for="plataforma">Plataforma:</label>
          <input
            type="text"
            id="plataforma"
            name="plataforma"
            placeholder="Ex: Nintendo DS"
            required
          />
        </div>

        <div class="campo">
          <label for="avaliacao">Avaliação:</label>
          <input
            type="number"
            id="avaliacao"
            name="avaliacao"
            min="1"
            max="5"
            step="0.1"
            placeholder="Ex: 4.5"
            required
          />
        </div>

        <div class="campo">
          <label for="foto">Foto:</label>
          <input type="file" id="foto" name="foto" accept="image/*" required />
        </div>

        <button type="submit">Cadastrar Produto</button>
      </form>
    </main>
  </body>
</html>