<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Faça um produto</h1>
    <form action="/api/produtos" method="post" enctype="multipart/form-data">
        <label for="nome">Nome:</label>
        <input type="text" name="nome"><br>

        <label for="preco">Preco:</label>
        <input type="number" name="preco" min="0" step="0.01"><br>

        <label for="lancamento">Ano de lançamento:</label>
        <input type="number" name="lancamento" min="1950"><br>

        <label for="plataforma">Plataforma:</label>
        <input type="text" name="plataforma"><br>

        <label for="avaliacao">Avaliaçao:</label>
        <input type="number" name="avaliacao" min="1" max="5" step="0.1"><br>

        <label for="foto">Foto:</label>
        <input type="file" name="foto" accept="image/*"><br>

        <button type="submit">Enviar</button>
    </form>
</body>
</html>